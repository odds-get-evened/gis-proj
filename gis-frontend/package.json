{
  "name": "gis-frontend",
  "version": "1.0.0",
  "main": "main.js",
  "repository": "gis-proj/gis-proj",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"uvicorn main:app --app-dir ..\" \"electron .\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nysdot.gislookup",
    "productName": "NYS GIS Lookup",
    "directories": {
      "output": "dist-installer"
    },
    "extraResources": [
      {
        "from": "../dist/gis-backend",
        "to": "bin/gis-backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
